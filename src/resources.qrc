        <file alias="Label.qml">style/OmaFontStyle/Label.qml</file>
        <file alias="Menu.qml">style/OmaFontStyle/Menu.qml</file>
        <file alias="MenuBar.qml">style/OmaFontStyle/MenuBar.qml</file>
